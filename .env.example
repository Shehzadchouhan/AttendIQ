# ==========================================
# FaceMark Environment Configuration
# Copy this file to .env before starting the app
# ==========================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=facemark_db
POSTGRES_SERVER=db
POSTGRES_PORT=5432

# SQLAlchemy Database URL
# For Docker Compose: host is 'db'
DATABASE_URL=postgresql://postgres:postgres@db:5432/facemark_db
# For Local Running without Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/facemark_db

# Security & JWT Configuration
# In production, generate a secure key with: openssl rand -hex 32
SECRET_KEY=supersecretkeyforfacemarkphase1jwtsecurityreplaceinprod!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Seed Admin & Teacher Credentials (used by seed.py)
SEED_ADMIN_EMAIL=admin@facemark.local
SEED_ADMIN_PASSWORD=admin123
INITIAL_ADMIN_NAME=System Administrator

SEED_TEACHER_EMAIL=teacher@facemark.local
SEED_TEACHER_PASSWORD=teacher123
INITIAL_TEACHER_NAME=Prof. Sharma

# Frontend API URL (accessible by browser)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Face Recognition Engine Settings (Phase 2)
MODEL_NAME=buffalo_l
DETECTION_SIZE=640
RECOGNITION_DET_SIZE=1280
MATCH_THRESHOLD=0.45
REVIEW_THRESHOLD=0.35
MIN_FACE_WIDTH=80
MIN_DET_SCORE=0.6
MAX_UPLOAD_MB=10
MAX_IMAGE_MEGAPIXELS=40

# Attendance & Reporting Settings (Phase 3)
ATTENDANCE_ALERT_THRESHOLD=75.0

# Security Hardening & DevOps Settings (Phase 4)
# In production, set ENVIRONMENT=production and replace passwords and SECRET_KEY!
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost
RATE_LIMIT_LOGIN=5/minute
